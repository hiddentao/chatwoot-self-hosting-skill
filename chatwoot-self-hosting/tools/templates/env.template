# Chatwoot environment. Copy to .env beside your compose file, fill every
# <...> value, and set the file mode to 600. Never commit the filled file.
#
# Values in <angle brackets> are placeholders. An email address in angle
# brackets is a real value, not a placeholder, which is why the check for
# unfilled names excludes anything containing an @:
#
#   grep -E '^[A-Z_]+=.*<[^<>@]*>' .env      # must print nothing

# --- Core -----------------------------------------------------------------------
# Alphanumeric only. Generate: openssl rand -hex 64
SECRET_KEY_BASE=<generated>
FRONTEND_URL=https://<your chatwoot hostname>
# The hostname itself, which the proxy answers TLS on.
DOMAIN=<your chatwoot hostname>
# false when TLS ends at an edge in front and the proxy marks requests https.
# true when this host answers visitors directly (topology B).
FORCE_SSL=false
# Exactly "false". Other values such as off, 0 or f leave signup ENABLED.
ENABLE_ACCOUNT_SIGNUP=false
RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=info

# --- MFA (Active Record encryption) ---------------------------------------------
# Generate: docker compose run --rm rails bundle exec rails db:encryption:init
# Losing these makes MFA secrets unreadable. There is no recovery.
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=<generated>
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=<generated>
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=<generated>

# --- Postgres -------------------------------------------------------------------
# Use the private host when the database is a managed service on the same
# network. Set the port your provider listens on: several do not use 5432, and
# a wrong port makes the container's readiness probe wait for ever with no
# useful error.
POSTGRES_HOST=<private host, or the postgres service name in topology B>
POSTGRES_PORT=<your provider's port>
POSTGRES_DATABASE=chatwoot
POSTGRES_USERNAME=chatwoot
POSTGRES_PASSWORD=<from your provider>
# Read by libpq for the app and for the entrypoint's readiness probe.
# Chatwoot's database.yml has no SSL setting, so this variable is how you ask
# for one. Drop it in topology B, where the connection never leaves the host.
PGSSLMODE=require
# Pool size per Rails process and per Sidekiq process.
RAILS_MAX_THREADS=5
SIDEKIQ_CONCURRENCY=5
# Deliberately absent: POSTGRES_STATEMENT_TIMEOUT. The default protects the
# live application, and migrations need a raised value passed to that one
# command instead. See upgrades.md, "the statement timeout".

# --- Redis (in compose) ---------------------------------------------------------
REDIS_URL=redis://redis:6379
# Generate: openssl rand -hex 32
REDIS_PASSWORD=<generated>

# --- Mail (outbound) -------------------------------------------------------------
# Sender for operator mail: notifications, invites and password resets. This is
# global. No account or inbox can override it.
MAILER_SENDER_EMAIL=Chatwoot <no-reply@<your verified sending domain>>
SMTP_DOMAIN=<your verified sending domain>
SMTP_ADDRESS=<your provider's smtp host>
SMTP_PORT=587
SMTP_USERNAME=<your provider's smtp username>
SMTP_PASSWORD=<your provider's smtp password or api key>
# The three below are transport settings, not Chatwoot settings: they describe
# how your provider expects to be spoken to, and the values here are what one
# provider on submission port 587 with STARTTLS wanted. Read your provider's
# own SMTP documentation and change them to match. A mismatch shows up as an
# authentication or TLS failure at send time, with nothing wrong in Chatwoot.
SMTP_AUTHENTICATION=login
SMTP_ENABLE_STARTTLS_AUTO=true
SMTP_OPENSSL_VERIFY_MODE=peer

# --- Storage ---------------------------------------------------------------------
# s3_compatible for an object store; local to write to a mounted volume.
ACTIVE_STORAGE_SERVICE=s3_compatible
STORAGE_BUCKET_NAME=<your bucket>
STORAGE_ACCESS_KEY_ID=<key id>
STORAGE_SECRET_ACCESS_KEY=<key secret>
STORAGE_REGION=<region>
STORAGE_ENDPOINT=https://<your object store endpoint>
# true when your store addresses buckets as a path, false when it uses a
# subdomain. Getting this wrong makes uploads fail with a 404 on a real bucket.
STORAGE_FORCE_PATH_STYLE=false

# --- Abuse limits ----------------------------------------------------------------
# Rack::Attack keys on the client address. Check that the address reaching
# Rails is one the client cannot forge before trusting these numbers.
ENABLE_RACK_ATTACK=true
# Upstream's default is 3000 a minute.
RACK_ATTACK_LIMIT=300
ENABLE_RACK_ATTACK_WIDGET_API=true
RATE_LIMIT_WIDGET_CONVERSATIONS=10
RATE_LIMIT_WIDGET_MESSAGES=30
RATE_LIMIT_WIDGET_CONTACTS=60
RATE_LIMIT_WIDGET_LOAD=200
RATE_LIMIT_WIDGET_TRANSCRIPT=5

# --- Topology B only ---------------------------------------------------------------
# Delete this block in topology A, where an edge in front holds the certificate.
# Caddy registers this address with the certificate authority and it receives
# expiry warnings. compose.single-box.yaml and Caddyfile.origin-tls both require
# it, and both refuse to start without it. Caddy's failure is at adaptation
# time: "wrong argument count or unexpected line ending after 'email'".
TLS_EMAIL=<address for certificate expiry notices>

# --- Mobile push ------------------------------------------------------------------
# Push goes through Chatwoot's relay, so message previews cross their servers.
# Turning it off means no push at all without a custom mobile app build.
ENABLE_PUSH_RELAY_SERVER=true
