# Topology B: no edge in front. Caddy answers visitors directly and gets its
# certificate from Let's Encrypt, so port 80 must redirect rather than serve.
#
# NOT VERIFIED. Topology A is the one that was built and measured.
{
	admin off
	email {$TLS_EMAIL}
}

{$DOMAIN} {
	# Admin, monitoring and first-run onboarding are never public.
	@private path /super_admin /super_admin/* /monitoring /monitoring/* /installation /installation/*
	handle @private {
		respond 404
	}

	handle /packs/js/sdk.js {
		root * /srv/sdk
		rewrite * /sdk.js
		header Access-Control-Allow-Origin "*"
		header Cache-Control "public, max-age=300"
		encode zstd gzip
		file_server
	}

	handle {
		reverse_proxy rails:3000 {
			# With no edge in front, the connection's own address is the client
			# address, and Caddy sets it. Do not copy a header here: any client
			# could then send one.
			header_up X-Forwarded-Proto https
		}
	}
}
